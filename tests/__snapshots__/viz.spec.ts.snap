// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`viz renderers > dict con clave cambiada 1`] = `"<div class="vcard"><div class="vname">count <span class="vtype">dict · 2 claves</span></div><div><span class="drow changed"><span class="dk">'a'</span><span class="dv">2</span></span><span class="drow"><span class="dk">'b'</span><span class="dv">1</span></span></div></div>"`;

exports[`viz renderers > linked list con ciclo 1`] = `"<div class="vcard"><div class="vname">curr <span class="vtype">linked list</span></div><div class="llrow"><div class="llnode">1</div><span class="llarrow">→</span><div class="llnode">2</div><span class="llnull">↺ ciclo</span></div></div>"`;

exports[`viz renderers > linked list con nodo cambiado 1`] = `"<div class="vcard"><div class="vname">head <span class="vtype">linked list</span></div><div class="llrow"><div class="llnode">1</div><span class="llarrow">→</span><div class="llnode changed">2</div><span class="llarrow">→</span><div class="llnode">3</div><span class="llnull">→ None</span></div></div>"`;

exports[`viz renderers > list con punteros y celda cambiada 1`] = `"<div class="vcard"><div class="vname">nums <span class="vtype">list · len 5</span></div><div class="cellrow"><div class="cellcol"><div class="cell">1</div><div class="cidx">0</div><div class="ptrs"></div></div><div class="cellcol"><div class="cell">1</div><div class="cidx">1</div><div class="ptrs"></div></div><div class="cellcol"><div class="cell changed">2</div><div class="cidx">2</div><div class="ptrs"><span class="ptr" style="color: #ffb454; background: #ffb45422; border: 1px solid #ffb45455;">i</span></div></div><div class="cellcol"><div class="cell">2</div><div class="cidx">3</div><div class="ptrs"></div></div><div class="cellcol"><div class="cell">3</div><div class="cidx">4</div><div class="ptrs"></div></div><div class="cellcol"><div class="cell" style="opacity:.25;border-style:dashed"></div><div class="cidx">5</div><div class="ptrs"><span class="ptr edge" style="color: #59c2ff; background: #59c2ff22; border: 1px solid #59c2ff55;">k</span></div></div></div></div>"`;

exports[`viz renderers > list truncada con item anidado 1`] = `"<div class="vcard"><div class="vname">xs <span class="vtype">list · len 121</span></div><div class="cellrow"><div class="cellcol"><div class="cell">1</div><div class="cidx">0</div><div class="ptrs"></div></div><div class="cellcol last"><div class="cell">…</div><div class="cidx">1</div><div class="ptrs"></div></div></div><div class="trunc-note">… mostrando los primeros 120</div></div>"`;

exports[`viz renderers > list vacía 1`] = `"<div class="vcard"><div class="vname">stack <span class="vtype">list · len 0</span></div><div class="cellrow"><span style="color:var(--faint);font-style:italic">[ ] vacío</span></div></div>"`;

exports[`viz renderers > matriz con cursor i/j y celda cambiada 1`] = `"<div class="vcard"><div class="vname">matrix <span class="vtype">matriz 2×2</span></div><table class="mtx"><tbody><tr><td class="midx"></td><td class="midx">0</td><td class="midx">1</td></tr><tr><td class="midx">0</td><td class="">1</td><td class="">2</td></tr><tr><td class="midx">1</td><td class="">3</td><td class="changed cursor">9</td></tr></tbody></table></div>"`;

exports[`viz renderers > prev de otro tipo se ignora (sin marcas de cambio) 1`] = `"<div class="vcard"><div class="vname">x <span class="vtype">set · 1</span></div><div><span class="schip">1</span></div></div>"`;

exports[`viz renderers > set con elemento nuevo 1`] = `"<div class="vcard"><div class="vname">seen <span class="vtype">set · 3</span></div><div><span class="schip">1</span><span class="schip">2</span><span class="schip changed">3</span></div></div>"`;

exports[`viz renderers > string como celdas (via cardCells) 1`] = `"<div class="vcard"><div class="vname">s <span class="vtype">str · len 4</span></div><div class="cellrow"><div class="cellcol"><div class="cell">h</div><div class="cidx">0</div><div class="ptrs"></div></div><div class="cellcol"><div class="cell">o</div><div class="cidx">1</div><div class="ptrs"><span class="ptr" style="color: #ffb454; background: #ffb45422; border: 1px solid #ffb45455;">i</span></div></div><div class="cellcol"><div class="cell">l</div><div class="cidx">2</div><div class="ptrs"></div></div><div class="cellcol last"><div class="cell changed">a</div><div class="cidx">3</div><div class="ptrs"></div></div></div></div>"`;

exports[`viz renderers > árbol binario con huecos 1`] = `"<div class="vcard"><div class="vname">root <span class="vtype">árbol binario</span></div><svg viewBox="0 0 256 206" style="width:100%;max-width:256px;display:block"><line x1="128" y1="26" x2="64" y2="88" stroke="#2e3750" stroke-width="1.5"></line><line x1="128" y1="26" x2="192" y2="88" stroke="#2e3750" stroke-width="1.5"></line><line x1="192" y1="88" x2="160" y2="150" stroke="#2e3750" stroke-width="1.5"></line><line x1="192" y1="88" x2="224" y2="150" stroke="#2e3750" stroke-width="1.5"></line><circle cx="128" cy="26" r="17" fill="#151923" stroke="#59c2ff" stroke-width="1.5"></circle><text x="128" y="30" text-anchor="middle" fill="#d7dce6" font-size="12" font-family="IBM Plex Mono">3</text><circle cx="64" cy="88" r="17" fill="#151923" stroke="#59c2ff" stroke-width="1.5"></circle><text x="64" y="92" text-anchor="middle" fill="#d7dce6" font-size="12" font-family="IBM Plex Mono">9</text><circle cx="192" cy="88" r="17" fill="#151923" stroke="#59c2ff" stroke-width="1.5"></circle><text x="192" y="92" text-anchor="middle" fill="#d7dce6" font-size="12" font-family="IBM Plex Mono">20</text><circle cx="160" cy="150" r="17" fill="#151923" stroke="#59c2ff" stroke-width="1.5"></circle><text x="160" y="154" text-anchor="middle" fill="#d7dce6" font-size="12" font-family="IBM Plex Mono">15</text><circle cx="224" cy="150" r="17" fill="#151923" stroke="#59c2ff" stroke-width="1.5"></circle><text x="224" y="154" text-anchor="middle" fill="#d7dce6" font-size="12" font-family="IBM Plex Mono">7</text></svg></div>"`;

exports[`viz renderers > árbol vacío 1`] = `"<div class="vcard"><div class="vname">root <span class="vtype">árbol binario</span></div><span style="color:var(--faint);font-style:italic">None</span></div>"`;
